{
    "manifest_version": 3,
    "name": "WordLit",
    "version": "1.0.0",
    "description": "Highlight a word to see its meaning and synonyms",
    "host_permissions": ["http://localhost:5400/*"],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "css": ["content.css"]
        }
    ]
}
